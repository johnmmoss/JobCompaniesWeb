@page
@model JobCompaniesWeb.Pages.Companies.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Company</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Company.Name" class="control-label"></label>
                <input asp-for="Company.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Company.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.CareersPageUrl" class="control-label"></label>
                <input asp-for="Company.CareersPageUrl" class="form-control" />
                <span asp-validation-for="Company.CareersPageUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.WebsiteUrl" class="control-label"></label>
                <input asp-for="Company.WebsiteUrl" class="form-control" />
                <span asp-validation-for="Company.WebsiteUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.Notes" class="control-label"></label>
                <input asp-for="Company.Notes" class="form-control" />
                <span asp-validation-for="Company.Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Company.CreatedAt" class="control-label"></label>
                <input asp-for="Company.CreatedAt" class="form-control" />
                <span asp-validation-for="Company.CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

